# Server
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=triflow
DB_PASSWORD=triflow
DB_NAME=triflow
DB_SSLMODE=disable
DB_MAX_CONNS=10

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Rate limit (auth endpoints)
RATELIMIT_AUTH_RPM=10

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=*
